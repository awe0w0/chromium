+#elif defined(V8_TARGET_OS_GTOS)
+# define V8_TARGET_OS_STRING "gtos"
 #elif defined(V8_TARGET_OS_LINUX)
 # define V8_TARGET_OS_STRING "linux"
 #elif defined(V8_TARGET_OS_MACOS)
@@ -288,7 +312,13 @@ path. Add it with -I<path> to the command line
 //   ...
 //  #endif
 
-#if defined (_MSC_VER)
