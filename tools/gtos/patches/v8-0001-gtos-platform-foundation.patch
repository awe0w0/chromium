diff --git a/BUILD.gn b/BUILD.gn
index 3e22cafa..468d3586 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -4,6 +4,12 @@
 
 # LINT.IfChange
 
+if (current_os == "gtos") {
+  assert(
+      false,
+      "GTOS V8 runtime backend is not implemented: qualified libc/C++, VM, thread/TLS/FP, entropy and file services are required. Host snapshot tools must retain the host OS.")
+}
+
 import("//build/config/android/config.gni")
 import("//build/config/arm.gni")
 import("//build/config/c++/c++.gni")
@@ -1132,6 +1138,7 @@ external_v8_defines = [
   "V8_HAVE_TARGET_OS",
   "V8_TARGET_OS_ANDROID",
   "V8_TARGET_OS_FUCHSIA",
+  "V8_TARGET_OS_GTOS",
   "V8_TARGET_OS_IOS",
   "V8_TARGET_OS_LINUX",
   "V8_TARGET_OS_MACOS",
@@ -1205,7 +1212,12 @@ if (v8_shortcut_strings_in_minor_ms) {
 # mksnapshot. We additionally set V8_HAVE_TARGET_OS to determine that a
 # target OS has in fact been set; otherwise we internally assume that target
 # OS == host OS (see v8config.h).
-if (target_os == "android") {
+if (target_os == "gtos") {
+  enabled_external_v8_defines += [
+    "V8_HAVE_TARGET_OS",
+    "V8_TARGET_OS_GTOS",
+  ]
+} else if (target_os == "android") {
   enabled_external_v8_defines += [ "V8_HAVE_TARGET_OS" ]
   enabled_external_v8_defines += [ "V8_TARGET_OS_ANDROID" ]
 } else if (target_os == "fuchsia") {
